{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleDetection": "legacy",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "outDir": "./dist"
  },
  "include": [
    "dheere-ai.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
